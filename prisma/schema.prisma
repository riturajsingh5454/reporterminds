// ReportersMind V2 — Prisma schema (MongoDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum ArchiveSection {
  JOURNALISM
  LEGACY_PRINT
}

enum TestimonialType {
  TEXT
  VIDEO
}

enum TestimonialCategory {
  STUDENT
  PROFESSIONAL
}

enum ContactRequestType {
  GENERAL
  MEETING
  SPEAKING
  MEDIA_INQUIRY
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum TimelineCategory {
  CAREER
  ACADEMIC
  MEDIA
  AWARD
}

enum AchievementCategory {
  AWARD
  RECOGNITION
  MILESTONE
}

// =========================================================================
// AUTH / USERS
// =========================================================================

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  avatarUrl    String?
  bio          String?
  socialLinks  Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles            Article[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// =========================================================================
// BOOKS
// =========================================================================

model Book {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  slug            String        @unique
  title           String
  subtitle        String?
  coverImage      String
  galleryImages   String[]
  description     String
  isbn            String?
  publisher       String?
  publishedYear   Int?
  language        String?
  pages           Int?
  price           Float?
  purchaseLinks   Json?
  category        String?
  isFeatured      Boolean       @default(false)
  status          ContentStatus @default(PUBLISHED)
  order           Int           @default(0)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reviews BookReview[]

  @@index([status, isFeatured])
  @@map("books")
}

model BookReview {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId         String   @db.ObjectId
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reviewerName   String
  reviewerAvatar String?
  rating         Int
  content        String
  source         String?
  isApproved     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([bookId])
  @@map("book_reviews")
}

// =========================================================================
// BLOG / ARTICLE CMS
// =========================================================================

model Article {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  slug            String        @unique
  title           String
  excerpt         String
  contentHtml     String
  contentJson     Json?
  coverImage      String
  categoryId      String?       @db.ObjectId
  category        ArticleCategory? @relation(fields: [categoryId], references: [id])
  tagIds          String[]      @db.ObjectId
  tags            Tag[]         @relation(fields: [tagIds], references: [id])
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  isFeatured      Boolean       @default(false)
  readTimeMins    Int           @default(1)
  viewCount       Int           @default(0)
  authorId        String?       @db.ObjectId
  author          User?         @relation(fields: [authorId], references: [id])
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model ArticleCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  articles    Article[]

  @@map("article_categories")
}

model Tag {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  slug     String    @unique
  articleIds String[] @db.ObjectId
  articles Article[] @relation(fields: [articleIds], references: [id])

  @@map("tags")
}

// =========================================================================
// JOURNALISM ARCHIVE / LEGACY IN PRINT
// =========================================================================

model Archive {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  slug            String          @unique
  title           String
  content         String?
  year            Int
  categoryId      String          @db.ObjectId
  category        ArchiveCategory @relation(fields: [categoryId], references: [id])
  publication     String?
  section         ArchiveSection  @default(JOURNALISM)
  attachments     Json[]
  tags            String[]
  isFeatured      Boolean         @default(false)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([section, year])
  @@index([categoryId])
  @@map("archives")
}

model ArchiveCategory {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  slug     String         @unique
  section  ArchiveSection @default(JOURNALISM)
  archives Archive[]

  @@map("archive_categories")
}

// =========================================================================
// YOUTUBE HUB
// =========================================================================

model Playlist {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  youtubePlaylistId String   @unique
  title             String
  description       String?
  thumbnail         String?
  videos            Video[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("playlists")
}

model Video {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  youtubeId   String    @unique
  title       String
  description String?
  thumbnail   String
  publishedAt DateTime
  durationSec Int?
  viewCount   Int       @default(0)
  category    String?
  isFeatured  Boolean   @default(false)
  playlistId  String?   @db.ObjectId
  playlist    Playlist? @relation(fields: [playlistId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([playlistId])
  @@map("videos")
}

// =========================================================================
// PHOTO GALLERY
// =========================================================================

model Gallery {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl   String
  caption    String?
  categoryId String          @db.ObjectId
  category   GalleryCategory @relation(fields: [categoryId], references: [id])
  width      Int?
  height     Int?
  eventName  String?
  location   String?
  order      Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([categoryId])
  @@map("gallery_items")
}

model GalleryCategory {
  id    String    @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  slug  String    @unique
  items Gallery[]

  @@map("gallery_categories")
}

// =========================================================================
// TESTIMONIALS
// =========================================================================

model Testimonial {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  type       TestimonialType     @default(TEXT)
  authorName String
  role       String?
  company    String?
  content    String
  videoUrl   String?
  avatarUrl  String?
  category   TestimonialCategory @default(PROFESSIONAL)
  rating     Int?
  isFeatured Boolean             @default(false)
  order      Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@map("testimonials")
}

// =========================================================================
// CONTACT / NEWSLETTER
// =========================================================================

model ContactRequest {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  type      ContactRequestType   @default(GENERAL)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@index([status, type])
  @@map("contact_requests")
}

model Newsletter {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  email        String           @unique
  status       NewsletterStatus @default(SUBSCRIBED)
  source       String?
  subscribedAt DateTime         @default(now())

  @@map("newsletter_subscribers")
}

// =========================================================================
// ABOUT PAGE: TIMELINE / ACHIEVEMENTS
// =========================================================================

model TimelineEvent {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  year        Int
  title       String
  description String
  category    TimelineCategory
  icon        String?
  imageUrl    String?
  order       Int              @default(0)

  @@map("timeline_events")
}

model Achievement {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  year        Int
  category    AchievementCategory
  issuer      String?
  imageUrl    String?

  @@map("achievements")
}

// =========================================================================
// FILE UPLOADS (stored in MongoDB)
// =========================================================================

model Upload {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  filename  String
  mimeType  String
  size      Int
  data      String   // base64-encoded file data
  createdAt DateTime @default(now())

  @@map("uploads")
}

// =========================================================================
// SEO / SITE SETTINGS / ANALYTICS
// =========================================================================

model SEOSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  path        String   @unique
  title       String?
  description String?
  ogImage     String?
  schemaJson  Json?
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
}

model SiteSettings {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  siteName         String   @default("ReportersMind")
  tagline          String?
  logoUrl          String?
  heroMedia        String?
  socialLinks      Json?
  contactEmail     String?
  yearsExperience   Int?
  studentsMentored  Int?
  articlesPublished Int?
  booksPublished    Int?
  videosCreated     Int?
  youtubeChannelId String?
  analyticsId      String?
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  referrer  String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}
